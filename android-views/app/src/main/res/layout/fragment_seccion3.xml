<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="HardcodedText">

    <LinearLayout style="@style/ContenidoSeccion">

        <include
            android:id="@+id/encabezado"
            layout="@layout/encabezado_seccion" />

        <!-- Casillas con estado indeterminado -->
        <com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView
            style="@style/Tarjeta"
            app:componente="MaterialCheckBox (checkedState)"
            app:descripcion="Permite marcar varias opciones de forma independiente. La casilla principal muestra un estado indeterminado cuando solo algunas opciones están marcadas."
            app:nombre="Casilla de verificación">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/casilla_todos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todos los ingredientes"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:orientation="vertical">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/casilla_queso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Queso" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/casilla_jamon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jamón" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/casilla_champinones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Champiñones" />
            </LinearLayout>

            <TextView
                android:id="@+id/resultado_casillas"
                style="@style/TextoResultado" />
        </com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView>

        <!-- Botones de opción (conexión con la Sección 5) -->
        <com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView
            style="@style/Tarjeta"
            app:componente="RadioGroup + MaterialRadioButton"
            app:descripcion="Permiten elegir una sola opción de un grupo. La opción elegida aquí define el tamaño de los textos de ejemplo que se muestran en la Sección 5."
            app:nombre="Botones de opción (conectado con la Sección 5)">

            <RadioGroup
                android:id="@+id/grupo_tamano"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/tamano_pequeno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pequeño" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/tamano_mediano"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mediano" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/tamano_grande"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grande" />
            </RadioGroup>

            <TextView
                android:id="@+id/vista_previa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Vista previa del texto"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <TextView
                android:id="@+id/resultado_tamano"
                style="@style/TextoResultado" />
        </com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView>

        <!-- Interruptor -->
        <com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView
            style="@style/Tarjeta"
            app:componente="MaterialSwitch"
            app:descripcion="Activa o desactiva una opción de forma inmediata, sin necesidad de confirmar. Es ideal para ajustes que se aplican al momento."
            app:nombre="Interruptor">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/interruptor_avion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="12dp"
                android:text="Modo avión"
                app:drawableStartCompat="@drawable/ic_airplanemode_active"
                app:thumbIcon="@drawable/icono_interruptor" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/interruptor_wifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Wi-Fi" />

            <TextView
                android:id="@+id/resultado_interruptor"
                style="@style/TextoResultado"
                android:text="Wi-Fi encendido" />
        </com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView>

        <!-- Deslizadores -->
        <com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView
            style="@style/Tarjeta"
            app:componente="Slider / RangeSlider"
            app:descripcion="Permiten elegir un valor numérico arrastrando un control sobre una pista. El de rango tiene dos controles para definir un mínimo y un máximo."
            app:nombre="Deslizador de valor único y de rango">

            <TextView
                android:id="@+id/texto_volumen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Volumen: 40 %" />

            <com.google.android.material.slider.Slider
                android:id="@+id/deslizador_volumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="Volumen"
                android:value="40"
                android:valueFrom="0"
                android:valueTo="100" />

            <TextView
                android:id="@+id/texto_precio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Precio: $200 – $800 MXN" />

            <com.google.android.material.slider.RangeSlider
                android:id="@+id/deslizador_precio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="Rango de precio"
                android:stepSize="50"
                android:valueFrom="0"
                android:valueTo="1000"
                app:values="@array/rango_precio" />
        </com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView>

        <!-- Lista desplegable -->
        <com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView
            style="@style/Tarjeta"
            app:componente="TextInputLayout (ExposedDropdownMenu) / Spinner"
            app:descripcion="Muestra la opción seleccionada y, al tocarla, despliega un menú con todas las alternativas. Ahorra espacio cuando hay muchas opciones."
            app:nombre="Lista desplegable">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Lenguaje favorito">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/lista_lenguajes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:text="Kotlin"
                    app:simpleItems="@array/lenguajes" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/resultado_lenguaje"
                style="@style/TextoResultado"
                android:text="Elegiste: Kotlin" />
        </com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView>

        <!-- Fecha y hora -->
        <com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView
            style="@style/Tarjeta"
            app:componente="MaterialDatePicker / MaterialTimePicker"
            app:descripcion="Diálogos que muestran un calendario o un reloj para elegir una fecha o una hora sin tener que escribirla, evitando errores de formato."
            app:nombre="Selector de fecha y de hora">

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/boton_fecha"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Elegir fecha"
                    app:icon="@drawable/ic_calendar_month" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/boton_hora"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Elegir hora"
                    app:icon="@drawable/ic_schedule" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:id="@+id/resultado_fecha"
                style="@style/TextoResultado"
                android:text="Fecha: sin elegir" />

            <TextView
                android:id="@+id/resultado_hora"
                style="@style/TextoResultado"
                android:layout_marginTop="0dp"
                android:text="Hora: sin elegir" />
        </com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView>

        <!-- Chips de filtro -->
        <com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView
            style="@style/Tarjeta"
            app:componente="ChipGroup + Chip (Filter)"
            app:descripcion="Etiquetas compactas que se activan o desactivan para filtrar contenido. Se pueden seleccionar varias a la vez y muestran una marca cuando están activas."
            app:nombre="Chips de filtro">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grupo_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/resultado_chips"
                style="@style/TextoResultado" />
        </com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
