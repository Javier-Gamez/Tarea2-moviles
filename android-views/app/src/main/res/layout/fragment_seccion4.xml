<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="HardcodedText">

    <LinearLayout style="@style/ContenidoSeccion">

        <include
            android:id="@+id/encabezado"
            layout="@layout/encabezado_seccion" />

        <!-- Lista vertical y detalle -->
        <com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView
            style="@style/Tarjeta"
            app:componente="RecyclerView + ListAdapter + Navigation"
            app:descripcion="Muestra muchos elementos de forma eficiente: reutiliza las vistas que salen de la pantalla. Toca un elemento para abrir su detalle. Los que agregues en la Sección 1 aparecen aquí."
            app:nombre="Lista vertical y detalle de elemento">

            <TextView
                android:id="@+id/total_lista"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lista_vertical"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:background="@drawable/fondo_lista" />
        </com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView>

        <!-- Cuadrícula -->
        <com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView
            style="@style/Tarjeta"
            app:componente="RecyclerView + GridLayoutManager(3)"
            app:descripcion="Organiza los elementos en filas y columnas, útil para galerías de fotos o catálogos. Toca las celdas para seleccionarlas."
            app:nombre="Cuadrícula de elementos">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cuadricula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/resultado_cuadricula"
                style="@style/TextoResultado" />
        </com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView>

        <!-- Encabezados de sección -->
        <com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView
            style="@style/Tarjeta"
            app:componente="RecyclerView + getItemViewType"
            app:descripcion="Agrupa los elementos bajo encabezados. Un solo adaptador combina tres tipos de fila (encabezado, contacto y aviso), cada uno con su propio layout."
            app:nombre="Lista con encabezados de sección">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lista_agrupada"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:background="@drawable/fondo_lista" />
        </com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView>

        <!-- Deslizar para eliminar -->
        <com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView
            style="@style/Tarjeta"
            app:componente="ItemTouchHelper.SimpleCallback"
            app:descripcion="Desliza un correo hacia cualquier lado para eliminarlo. Se dibuja un fondo rojo con un ícono de papelera y un snackbar permite deshacer la acción."
            app:nombre="Deslizar para eliminar">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/lista_correos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fondo_lista"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/bandeja_vacia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Bandeja vacía"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/boton_restaurar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Restaurar correos" />
        </com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView>

        <!-- Actualizar arrastrando -->
        <com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView
            style="@style/Tarjeta"
            app:componente="SwipeRefreshLayout"
            app:descripcion="Al arrastrar la lista hacia abajo desde el inicio aparece un indicador de carga y se obtienen elementos nuevos. Es el gesto estándar para refrescar."
            app:nombre="Actualizar arrastrando hacia abajo">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/refrescar"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:background="@drawable/fondo_lista">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lista_noticias"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <TextView
                android:id="@+id/resultado_noticias"
                style="@style/TextoResultado" />
        </com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView>

        <!-- Estado vacío -->
        <com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView
            style="@style/Tarjeta"
            app:componente="LinearLayout + ImageView + TextView (visibility)"
            app:descripcion="Cuando no hay elementos se muestra una ilustración con un mensaje que explica la situación y una acción para salir de ella, en lugar de una pantalla en blanco."
            app:nombre="Estado vacío">

            <LinearLayout
                android:id="@+id/contenedor_tareas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/lista_tareas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/boton_vaciar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vaciar lista" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/estado_vacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="16dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/circulo_secundario"
                    android:importantForAccessibility="no"
                    android:padding="24dp"
                    android:src="@drawable/ic_inbox"
                    app:tint="?attr/colorOnSecondaryContainer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="No hay tareas pendientes"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Cuando agregues tareas aparecerán aquí."
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/boton_ejemplo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Agregar tareas de ejemplo" />
            </LinearLayout>
        </com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView>

        <!-- Pestañas -->
        <com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView
            style="@style/Tarjeta"
            app:componente="TabLayout + ViewPager2 + TabLayoutMediator"
            app:descripcion="Dividen el contenido en categorías del mismo nivel. Se puede cambiar de pestaña tocándola o deslizando el contenido hacia los lados."
            app:nombre="Pestañas con contenido deslizable">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/pestanas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/paginador"
                android:layout_width="match_parent"
                android:layout_height="160dp" />

            <TextView
                android:id="@+id/resultado_pestana"
                style="@style/TextoResultado" />
        </com.javiergamez.catalogoui.views.componentes.ElementoCatalogoView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
